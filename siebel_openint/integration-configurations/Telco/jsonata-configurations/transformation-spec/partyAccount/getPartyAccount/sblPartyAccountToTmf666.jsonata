(
    $accountType := $lowercase($.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Type");
    $accountClass := $lowercase($.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Account Type Code");
    $primaryContactId := $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Primary Contact Id";
    $primaryBillingProfileId := $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Primary Billing Profile Id";
    $comInvoiceProfileList := $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."ListOfCom Invoice Profile"."Com Invoice Profile";
    $account := $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account;
    $listOfContact := $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account.ListOfContact.Contact;

    $createResponseBody := (
        {
            "@type": "PartyAccount",
            "accountType": ( $accountType = "residential" ? "consumer" : $accountType ),
            "accountClass": ( $accountClass = "residential" ? "consumer" : $accountClass ),
            "name": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account.Name,
            "externalId": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Account Number",
            "id": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Account Number",
            "state": $lowercase(
                $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Account Status"
            ),
            "billStructure": $comInvoiceProfileList[(`Id`=$primaryBillingProfileId)].{
                "@type": "BillStructure",
                "name": `Name`,
                "id": `Id`,
                "cycleSpecification": {
                    "@type": "BillingCycleSpecification",
                    "billingDateShift": (
                        $bcd := `Bill Cycle`;
                        $bcd != "" ? $number($bcd) : 1
                    ),
                    "billingPeriod": $lowercase(`Bill Frequency`),
                    "frequency": $lowercase(`Bill Frequency`)
                },
                "format": {
                    "@type": "BillFormat",
                    "name": $lowercase(`Bill Type`)
                },
                "presentationMedia": [
                    {
                        "@type": "BillPresentationMedia",
                        "name": $lowercase(`Media Type`)
                    }
                ]
            },
            "serviceBillStructure": [
                $comInvoiceProfileList[(`Id`!=$primaryBillingProfileId)].{
                    "@type": "BillStructure",
                    "name": `Name`,
                    "id": `Id`,
                    "cycleSpecification": {
                        "@type": "BillingCycleSpecification",
                        "billingDateShift": (
                            $bcd := `Bill Cycle`;
                            $bcd != "" ? $number($bcd) : 1
                        ),
                        "billingPeriod": $lowercase(`Bill Frequency`),
                        "frequency": $lowercase(`Bill Frequency`)
                    },
                    "format": {
                        "@type": "BillFormat",
                        "name": $lowercase(`Bill Type`)
                    },
                    "presentationMedia": [
                        {
                            "@type": "BillPresentationMedia",
                            "name": $lowercase(`Media Type`)
                        }
                    ]
                }
            ],
            "contact": [
                $listOfContact.{
                    "@type": "Contact",
                    "contactName": `First Name` & (`Middle Name` != "" ? " " & `Middle Name` & " " : " ") & `Last Name`,
                    "partyRoleType": `Contact Person Title`,
                    "contactType": (`Row Id` = $primaryContactId ? "primary" : "secondary"),
                    "contactMedium": [
                        {
                            "@type": "GeographicAddressContactMedium",
                            "preferred": true,
                            "mediumType": "PostalAddress",
                            "city": $account."ListOfCUT Address"."CUT Address"[0].City,
                            "country": $account."ListOfCUT Address"."CUT Address"[0].Country,
                            "postCode": $account."ListOfCUT Address"."CUT Address"[0]."Postal Code",
                            "street1": $account."ListOfCUT Address"."CUT Address"[0]."Street Address",
                            "street2": $account."ListOfCUT Address"."CUT Address"[0]."Street Address 2",
                            "stateOrProvince": $account."ListOfCUT Address"."CUT Address"[0].State
                        },
                        {
                            "@type": "EmailContactMedium",
                            "mediumType": "Email",
                            "emailAddress": $."Email Address"
                        },
                        {
                            "@type": "PhoneContactMedium",
                            "mediumType": "Phone",
                            "phoneNumber": $."Cellular Phone #"
                        }
                    ],
                    "relatedParty": [
                        {
                            "role": "owner",
                            "@type": "RelatedRelatedPartyOracle",
                            "partyOrPartyRole": {
                                "@type": "RelatedPartyOracle",
                                "@referredType": "Individual",
                                "@baseType": "RelatedParty",
                                "href": "",
                                "id": $account."Account Number",
                                "name": $account."Name"
                            }
                        }
                    ]
                }
            ],
            "defaultPaymentMethod": {
                "@type": "PaymentMethodRef",
                "href": "",
                "id": "",
                "name": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."ListOfCom Invoice Profile"."Com Invoice Profile"[0]."Payment Method"
            },
            "relatedParty": [
                {
                    "role": "owner",
                    "@type": "RelatedRelatedPartyOracle",
                    "partyOrPartyRole": {
                        "@type": "RelatedPartyOracle",
                        "@referredType": "Individual",
                        "@baseType": "RelatedParty",
                        "href": "",
                        "id": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Account Number",
                        "name": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Name"
                    }
                }
            ],
            "accountRelationship": [
                $.global.parentAccountId ? {
                    "@type": "AccountRelationship",
                    "relationshipType": "Parent",
                    "validFor": {
                        "startDateTime": "",
                        "endDateTime": ""
                    },
                    "billStructure": {
                        "id": $.get_party_account.SiebelMessage.ListOfSWICustomerPartyIO.Account."Primary Billing Profile Id"
                    },
                    "account": {
                        "@type": "AccountRef",
                        "@referredType": "BillingAccount",
                        "id": $.global.parentAccountId,
                        "name": $.global.parentAccountName,
                        "billStructure": {
                            "id": $.global.parentAccountPrimaryBillPrfId
                        }
                    }
                }
            ]
        }
    );

    /* final body - start */
    $createResponseBody
    /* final body - end */
)