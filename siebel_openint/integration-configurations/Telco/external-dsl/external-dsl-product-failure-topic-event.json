{
  "input": {
    "type": "object"
  },
  "global": [
    "tt_id"
  ],
  "output": {
    "type": "object"
  },
  "steps": {
    "SRList_sync_fail": {
      "type": "RESTOutbound",
      "restSpec": "siebel-tmf-dbe",
      "endPoint": "SWI Trouble Ticket Service/Insert",
      "method": "POST",
      "inputHeaders": {
        "Content-Type": "application/json"
      },
      "queryParams": {
        "matchrequestformat": "y"
      },
      "inputSpecification": {
        "dataCollection": [
          {
            "source": "WorkflowInput"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "specialRatingList/srlist-trouble-ticket-data-collection.jsonata"
          }
        ]
      },
      "retryConfig": {
        "retryDelayMilliseconds": 50,
        "retryBackoffMultiplier": 2.0,
        "retryTotalTimeoutMilliseconds": 900,
        "retryExcludeStatusCodes": [404, 200]
      },
      "output": {
        "global.tt_id": "${output.SiebelMessage.ListOfSWITroubleTicketIO.'Trouble Ticket'[0].Id}"
      }
    }
  },
  "response": {
    "success": {
      "payload": {
        "dataCollection": [
          {
            "source": "SRList_sync_fail"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/Match_Request_Trouble_Ticket.jsonata"
          }
        ]
      },
      "statusCode": 200
    },
    "error": {
      "payload": {
        "dataCollection": [
          {
            "source": "SRList_sync_fail"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/Match_Request_Trouble_Ticket.jsonata"
          }
        ]
      },
      "statusCode": 200
    }
  },
  "transitions": {
    "$start": {
      "transitions": [
        {
          "target": "SRList_sync_fail"
        }
      ]
    },
    "SRList_sync_fail": {
      "transitions": [
        {
          "condition": "${global.tt_id != ''}",
          "target": "$end"
        },
        {
          "target": "$errorEnd"
        }
      ]
    }
  }
}