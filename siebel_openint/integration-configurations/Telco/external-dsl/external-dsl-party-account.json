  "output": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "publish_status": {
        "type": "string"
      },
      "exception": {
        "type": "object"
      }
    }
  },
  "steps": {
    "get_parent_party_account": {
      "type": "RESTOutbound",
      "restSpec": "siebel-tmf-dbe",
      "endPoint": "SWI Customer Party Service/QueryById",
      "method": "POST",
      "inputHeaders": {
        "Content-Type": "application/json"
      },
      "queryParams": {
        "matchrequestformat": "y"
      },
      "inputSpecification": {
        "dataCollection": [
          {
            "source": "WorkflowInput"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/getCustomerPartyAccountForHierarchy-dt.jsonata"
          }
        ]
      },
      "retryConfig": {
        "retryDelayMilliseconds": 50,
        "retryBackoffMultiplier": 2.0,
        "retryTotalTimeoutMilliseconds": 900,
        "retryExcludeStatusCodes": [
          404,
          200
        ]
      },
      "output": {
        "global.parentAccountId": "${output.SiebelMessage.ListOfSWICustomerPartyIO.Account[0].'Account Number'}",
        "global.parentAccountName": "${output.SiebelMessage.ListOfSWICustomerPartyIO.Account[0].'Name'}",
        "global.parentAccountPrimaryBillPrfId": "${output.SiebelMessage.ListOfSWICustomerPartyIO.Account[0].'Primary Billing Profile Id'}"
      }
    },
    "brm_event_publish": {
      "type": "EventPublish",
      "queue": "brm-event-publish",
      "inputHeaders": {
        "correlation-id": "${input.correlationId}",
        "account-id": "${WorkflowInput.SiebelMessage.ListOfSWICustomerPartyIO.Account.'Account Number' ?: ''}"
      },
      "inputSpecification": {
        "dataCollection": [
          {
            "source": "WorkflowInput",
            "transformationSpec": "partyAccount/sblPartyAccountToTmf666.jsonata"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/sblPartyAccountToTmf666-FinalScript.jsonata"
          }
        ]
      },
      "output": {
        "global.event_status": "${publish_status}"
      }
    },
    "brm_event_publish_with_hierarchy": {
      "type": "EventPublish",
      "queue": "brm-event-publish",
      "inputHeaders": {
        "correlation-id": "${input.correlationId}",
        "account-id": "${WorkflowInput.SiebelMessage.ListOfSWICustomerPartyIO.Account.'Account Number' ?: ''}"
      },
      "inputSpecification": {
        "dataCollection": [
          {
            "source": "WorkflowInput"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/sblPartyAccountToTmf666ForHierarchy.jsonata"
          }
        ]
      },
      "output": {
        "global.event_status": "${publish_status}"
      }
    }
  },
  "response": {
    "success": {
      "payload": {
        "dataCollection": [
          {
            "source": "brm_event_publish"
          },
          {
            "source": "brm_event_publish_with_hierarchy"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/MatchRequest_brm_event_publish.jsonata"
          }
        ]
      },
      "statusCode": "${global.event_status == true ? 200 : 500}",
      "headers": {
        "X-Flow-Result": "success"
      }
    },
    "error": {
      "payload": {
        "dataCollection": [
          {
            "source": "brm_event_publish"
          },
          {
            "source": "brm_event_publish_with_hierarchy"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/MatchRequest_brm_event_publish.jsonata"
          }
        ]
      },
      "statusCode": "${global.event_status == true ? 200 : 500}",
      "headers": {
        "X-Flow-Result": "error"
      }
    }
  },
  "transitions": {
    "$start": {
      "transitions": [
        {
          "condition": "${var parentAccountId = WorkflowInput.SiebelMessage.ListOfSWICustomerPartyIO.Account.'Parent Account Id' ?: ''; parentAccountId == ''}",
          "target": "brm_event_publish"
        },
        {
          "condition": "${var parentAccountId = WorkflowInput.SiebelMessage.ListOfSWICustomerPartyIO.Account.'Parent Account Id' ?: ''; parentAccountId != ''}",
          "target": "get_parent_party_account"
        }
      ]
    },
    "get_parent_party_account": {
      "transitions": [
        {
          "condition": "${global.parentAccountId != ''}",
          "target": "brm_event_publish_with_hierarchy"
        },
        {
          "condition": "${global.parentAccountId == ''}",
          "target": "$errorEnd"
        },
        {
          "target": "$errorEnd"
        }
      ]
    },
    "brm_event_publish": {
      "transitions": [
        {
          "condition": "${global.event_status == true}",
          "target": "$end"
        },
        {
          "condition": "${global.event_status == false}",
          "target": "$errorEnd"
        },
        {
          "target": "$errorEnd"
        }
      ]
    },
    "brm_event_publish_with_hierarchy": {
      "transitions": [
        {
          "condition": "${global.event_status == true}",
          "target": "$end"
        },
        {
          "condition": "${global.event_status == false}",
          "target": "$errorEnd"
        },
        {
          "target": "$errorEnd"
        }
      ]
    }
  }
}