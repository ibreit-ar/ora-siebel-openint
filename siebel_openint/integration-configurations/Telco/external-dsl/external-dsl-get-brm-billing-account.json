  "steps": {
    "get_brm_billing_account": {
      "type": "RESTOutbound",
      "restSpec": "brm-tmf-dbe",
      "endPoint": "/brm/accountManagement/v5/billingAccount/{billing-account-id}",
      "method": "GET",
      "pathParams": {
        "billing-account-id": "${WorkflowInput.id}"
      },
      "inputHeaders": {
        "Content-Type": "application/json"
      },
      "queryParams": {
        "id": "${WorkflowInput.id}"
      },
      "inputSpecification": {
        "dataCollection": [
          {
            "source": "WorkflowInput"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/getBRMBillingAccount-dt.jsonata"
          }
        ]
      },
      "retryConfig": {
        "retryDelayMilliseconds": 50,
        "retryBackoffMultiplier": 2.0,
        "retryTotalTimeoutMilliseconds": 900,
        "retryExcludeStatusCodes": [
          404,
          200
        ]
      },
      "output": {
        "global.rest_status": "${status}"
      }
    }
  },
  "response": {
    "success": {
      "payload": {
        "dataCollection": [
          {
            "source": "get_brm_billing_account"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/getBRMBillingAccount-rsp.jsonata"
          }
        ]
      },
      "statusCode": "${global.rest_status == '200' ? 200 : 500}",
      "headers": {
        "X-Flow-Result": "success"
      }
    },
    "error": {
      "payload": {
        "dataCollection": [
          {
            "source": "get_brm_billing_account"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/getBRMBillingAccount-rsp.jsonata"
          }
        ]
      },
      "statusCode": "${global.rest_status == '200' ? 200 : 500}",
      "headers": {
        "X-Flow-Result": "success"
      }
    }
  },
  "transitions": {
    "$start": {
      "transitions": [
        {
          "target": "get_brm_billing_account"
        }
      ]
    },
    "get_brm_billing_account": {
      "transitions": [
        {
          "condition": "${global.rest_status == '200'}",
          "target": "$end"
        },
        {
          "target": "$errorEnd"
        }
      ]
    }
  }
