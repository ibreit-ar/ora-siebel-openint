            "source": "brm_event_publish_SWICustomerPartyIO"
          },
          {
            "source": "brm_event_publish_SWIContactIO"
          },
          {
            "source": "brm_event_publish_SWIBillingProfileIO"
          },
          {
            "source": "brm_event_publish_SWIAddressIO"
          },
          {
            "source": "brm_event_publish_SWIAccountContactIO"
          },
          {
            "source": "brm_event_publish_SWIAccountAddressIO"
          },
          {
            "source": "brm_event_publish_SWIAccountHierarchyIO"
          }
        ],
        "transformation": [
          {
            "transformationSpec": "partyAccount/MatchRequest_brm_event_publish.jsonata"
          }
        ]
