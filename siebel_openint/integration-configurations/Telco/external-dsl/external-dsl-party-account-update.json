  "transitions": {
    "$start": {
      "transitions": [
        {
          "condition": "${var intObjectName = WorkflowInput.SiebelMessage.'IntObjectName' ?: ''; intObjectName == 'SWICustomerPartyIO'}",
          "target": "get_party_account_SWICustomerPartyIO"
        },
        {
          "condition": "${var intObjectName = WorkflowInput.SiebelMessage.'IntObjectName' ?: ''; intObjectName == 'SWIContactIO'}",
          "target": "get_party_account_SWIContactIO"
        },
        {
          "condition": "${var intObjectName = WorkflowInput.SiebelMessage.'IntObjectName' ?: ''; intObjectName == 'SWIBillingProfileIO'}",
