          "target": "get_party_account_SWIAccountHierarchyIO"
        }
      ]
    },
    "get_party_account_SWICustomerPartyIO": {
      "transitions": [
        {
          "condition": "${global.partyAccountId != ''}",
          "target": "brm_event_publish_SWICustomerPartyIO"
        },
        {
          "condition": "${global.partyAccountId == ''}",
          "target": "$errorEnd"
        },
        {
          "target": "$errorEnd"
        }
      ]
    },
    "brm_event_publish_SWICustomerPartyIO": {
      "transitions": [
        {
          "condition": "${global.event_status == true}",
          "target": "$end"
        },
        {
          "condition": "${global.event_status == false}",
          "target": "$errorEnd"
        },
        {
          "target": "$errorEnd"
        }
      ]
    },
    "get_party_account_SWIContactIO": {
      "transitions": [
        {
          "condition": "${get_party_account_SWIContactIO.failureCount < 1}",
          "target": "brm_event_publish_SWIContactIO"
        },
        {
          "condition": "${get_party_account_SWIContactIO.failureCount > 0}",
          "target": "$errorEnd"
        },
        {
          "target": "$errorEnd"
        }
      ]
    },
