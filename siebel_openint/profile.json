{
  "Openint": {
    "client": {
      "tls": {
        "private-key": {
          "keystore": {
            "resource": {
              "resource-path": "keystore_client.jks"
            },
            "type": "JKS",
            "passphrase": "siebel",
            "key": {
              "alias": "siebel"
            }
          }
        }
      }
    },
    "server": {
      "tls": {
        "trust": {
          "keystore": {
            "resource": {
              "resource-path": "truststore.jks"
            },
            "type": "JKS",
            "passphrase": "siebel",
            "trust-store": true
          }
        },
        "private-key": {
          "keystore": {
            "resource": {
              "resource-path": "keystore.jks"
            },
            "type": "JKS",
            "passphrase": "siebel",
            "key": {
              "alias": "siebel"
            }
          }
        }
      }
    },
      "features": {
        "security": {
          "defaults": {
            "authenticate": false,
            "authorize": false
          },
          "paths": [
            {
              "path": "/openintegration/v1.0/[{+path}/]{last:(?!describe$)[^/]+}[/]",
              "methods": [
                "get",
                "post",
                "put",
                "delete"
              ],
              "abac": {
                "scopes": [
                  "read"
                ]
              }
            }
          ]
        }
      },
    "restrictive-cors": {
      "allow-origins": [],
      "allow-methods": []
    },
    "cache": {
      "enabled": false
    },
    "threshold": {
      "session-usage-percent": 75
    },
    "integrations": {
      "jsonata": {
        "pool": {
          "max-size": 8,
          "acquire-timeout-millis": 250,
          "idle-ttl-millis": 300000,
          "cleanup-interval-millis": 30000
        }
      }
    },
    "tracing": {
      "enabled": false
    },
    "cache": {
      "enabled": "true",
      "wka": [
        "coherence-nodeport-siebelcache.oidev.svc.cluster.local"
      ],
      "tlsEnabled": "true",
      "cluster-name": "siebelcache"
    }
  },
  "Profile": {
    "ProfileName": "siebelopenint"
  },
  "ConfigParam": {
    "Applications": [
      {
        "Name": "ecommunications_sso",
        "Language": "esn",
        "ObjectManager": "eCommunicationsObjMgrSSO_esn",
        "MaxTasks": 20,
        "AuthenticationProperties": {
          "UserSpec": "X-Siebel-User",
          "TrustToken": "Sadmin22__Aa",
          "SingleSignOn": true,
          "AnonUserName": "SADMIN",
          "SessionTimeout": 300,
          "GuestSessionTimeout": 300
        }
      },
      {
        "Name": "eai_sso",
        "Language": "esn",
        "ObjectManager": "EAIObjMgrSSO_esn",
        "MaxTasks": 20,
        "AuthenticationProperties": {
          "UserSpec": "X-Siebel-User",
          "TrustToken": "Sadmin22__Aa",
          "SingleSignOn": true,
          "AnonUserName": "SADMIN",
          "SessionTimeout": 300,
          "GuestSessionTimeout": 300
        }
      }
    ],
    "RESTInBound": {
      "MaxConnections": 20,
      "RESTAuthenticationProperties": {
        "AnonUserName": "SADMIN",
        "UserSpec": "X-Siebel-User",
        "TrustToken": "Sadmin22__Aa"
      },
      "ObjectManager": "EAIObjMgrSSO_esn"
    }
  }
}
